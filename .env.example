APP_NAME=ContextOps
APP_VERSION=0.1.0
ENVIRONMENT=development
API_BASE_URL=http://127.0.0.1:8000

# ============================================================
# Microsoft Foundry
# ============================================================

FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project

# LLM
FOUNDRY_MODEL_NAME=your-chat-model
FOUNDRY_MODEL_DEPLOYMENT_NAME=contextops-chat

# Vision
FOUNDRY_VISION_MODEL_NAME=your-vision-model
FOUNDRY_VISION_MODEL_DEPLOYMENT_NAME=contextops-vision

# Embeddings
FOUNDRY_EMBEDDING_MODEL_NAME=text-embedding-3-small
FOUNDRY_EMBEDDING_DEPLOYMENT_NAME=contextops-embedding


# ============================================================
# RAG Strategy
# ============================================================

EMBEDDING_PROVIDER=microsoft_foundry
CHUNKING_STRATEGY=hybrid

# Retrieval chunk budget.
# This is a tunable retrieval parameter, NOT the tokenizer limit.
CHUNK_MAX_TOKENS=800


# ============================================================
# Azure Blob Storage
# ============================================================

AZURE_STORAGE_CONNECTION_STRING=your-azure-connection-string
AZURE_STORAGE_CONTAINER_NAME=contextops-documents


# ============================================================
# PostgreSQL
# ============================================================

DATABASE_URL=postgresql+psycopg://postgres:genai@localhost:5432/contextops


# ============================================================
# Qdrant
# ============================================================

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=contextops_documents

# Custom / tiered tenant sharding
QDRANT_SHARDING_METHOD=custom

# Number of physical shards PER shard key.
# Keep 1 for tenant-level isolation.
QDRANT_SHARD_NUMBER=1

# Shared fallback shard for small/normal tenants.
QDRANT_DEFAULT_SHARD_KEY=default

# Current prototype tenant.
DEFAULT_TENANT_ID=contextops