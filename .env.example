# ============================================================
# ContextOps - Environment Configuration Template
# ============================================================

# ============================================================
# PRODUCTION NOTES
# ============================================================

# .env is for local development only.
#
# Production secrets such as:
# - Microsoft Foundry credentials
# - Azure Storage credentials
# - PostgreSQL credentials
# - Qdrant API keys
# - LangSmith API keys
#
# must be supplied through the deployment environment,
# managed identity, or a managed secret store.
#
# Never commit real secrets, API keys, passwords, connection
# strings, or credentials to Git.


# ============================================================
# ContextOps Application
# ============================================================

APP_NAME=ContextOps
APP_VERSION=0.1.0
ENVIRONMENT=development
API_BASE_URL=http://127.0.0.1:8000


# ============================================================
# LLM Provider
# ============================================================

# Select the LLM provider used by the application.
#
# Supported:
#   microsoft_foundry
#   open_source (future provider)
#
# Microsoft Foundry is the current ContextOps provider.
LLM_PROVIDER=microsoft_foundry


# ============================================================
# Microsoft Foundry
# ============================================================

FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_OPENAI_ENDPOINT=https://contextops-foundry.cognitiveservices.azure.com/ # Resource-level Azure OpenAI endpoint. Used for direct embedding API calls.

# ------------------------------------------------------------
# Chat LLM
# ------------------------------------------------------------

FOUNDRY_MODEL_NAME=your-chat-model
FOUNDRY_MODEL_DEPLOYMENT_NAME=contextops-chat


# ------------------------------------------------------------
# Vision LLM
# ------------------------------------------------------------

FOUNDRY_VISION_MODEL_NAME=your-vision-model
FOUNDRY_VISION_MODEL_DEPLOYMENT_NAME=contextops-vision


# ------------------------------------------------------------
# Embedding Model
# ------------------------------------------------------------

FOUNDRY_EMBEDDING_MODEL_NAME=text-embedding-3-small
FOUNDRY_EMBEDDING_DEPLOYMENT_NAME=contextops-embedding


# ============================================================
# RAG Strategy
# ============================================================

# Dense embedding provider used by the retrieval pipeline.
EMBEDDING_PROVIDER=microsoft_foundry

# Chunking strategy used during document ingestion.
CHUNKING_STRATEGY=hybrid

# Retrieval chunk budget.
# This is a tunable retrieval parameter, NOT the tokenizer limit.
CHUNK_MAX_TOKENS=800


# ============================================================
# Azure Blob Storage
# ============================================================

# Azure Storage connection string.
# Replace with the actual value in your local .env file.
AZURE_STORAGE_CONNECTION_STRING=your-azure-connection-string

# Blob container used for uploaded documents.
AZURE_STORAGE_CONTAINER_NAME=contextops-documents


# ============================================================
# PostgreSQL
# ============================================================

# Local development PostgreSQL connection.
#
# Docker Compose overrides this for the application container
# to use the PostgreSQL service hostname.
DATABASE_URL=postgresql+psycopg://postgres:genai@localhost:5432/contextops


# ============================================================
# Qdrant Vector Database
# ============================================================

# Local Qdrant HTTP endpoint.
QDRANT_URL=http://localhost:6333

# Leave empty when authentication is not enabled locally.
# Provide the real API key through the deployment environment
# in production.
QDRANT_API_KEY=

# Main Qdrant collection.
QDRANT_COLLECTION_NAME=contextops_documents


# ------------------------------------------------------------
# Qdrant Tenant Sharding
# ------------------------------------------------------------

# Tenant sharding strategy.
QDRANT_SHARDING_METHOD=custom

# Number of physical shards PER shard key.
# Keep 1 for tenant-level isolation in the prototype.
QDRANT_SHARD_NUMBER=1

# Shared fallback shard for small/normal tenants.
QDRANT_DEFAULT_SHARD_KEY=default

# Default tenant used by the current prototype.
DEFAULT_TENANT_ID=contextops


# ------------------------------------------------------------
# Sparse / BM25 Retrieval
# ------------------------------------------------------------

# FastEmbed BM25 sparse embedding model.
BM25_MODEL_NAME=Qdrant/bm25

# Sparse embedding provider.
SPARSE_EMBEDDING_PROVIDER=bm25

# FastEmbed model cache directory.
#
# Direct local execution with uv on Windows:
FASTEMBED_CACHE_DIR=.cache/fastembed
#
# Docker Compose overrides this with:
# /app/.cache/fastembed


# ============================================================
# Retrieval & Context Configuration
# ============================================================

# Number of documents/chunks initially retrieved.
RETRIEVAL_TOP_K=10

# Number of recent conversation messages available
# to the query workflow.
CONVERSATION_RECENT_MESSAGE_LIMIT=6

# Maximum number of candidates passed to the reranker.
RERANK_CANDIDATE_LIMIT=20

# Maximum number of documents included in the final context.
CONTEXT_MAX_DOCUMENTS=5

# Maximum token budget for the final retrieved context.
CONTEXT_MAX_TOKENS=6000


# ============================================================
# Redis Cache
# ============================================================

# Local development Redis instance.
#
# Docker Compose overrides this for the application container
# to use the Redis service hostname.
REDIS_URL=redis://localhost:6379/0

# Cache entry lifetime in seconds.
REDIS_CACHE_TTL_SECONDS=300

# Prefix used for ContextOps cache keys.
REDIS_CACHE_KEY_PREFIX=contextops:cache:


# ============================================================
# LangSmith
# ============================================================

# Enable/disable LangSmith tracing.
LANGSMITH_TRACING=false

# LangSmith API key.
# Leave empty when tracing is disabled.
# Never commit a real API key to Git.
LANGSMITH_API_KEY=

# LangSmith project name.
LANGSMITH_PROJECT=contextops

# LangSmith API endpoint.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional LangSmith workspace ID.
LANGSMITH_WORKSPACE_ID=